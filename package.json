{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro sync && tsc --noEmit",
