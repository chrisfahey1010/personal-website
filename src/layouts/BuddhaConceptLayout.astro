---
import '../styles/buddha-demo.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Buddha Decision Desk | Interview concept by Chris Fahey',
  description =
    'An independent interview concept showing how public product information and synthetic operations data could support explainable decisions.',
  canonicalPath = '/buddha/',
} = Astro.props;

const canonicalHref = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="googlebot" content="noindex,nofollow,noarchive" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f5f7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <link rel="canonical" href={canonicalHref} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23191b1f'/%3E%3Cpath d='M32 12 52 32 32 52 12 32Z' fill='%23b28b4c'/%3E%3Cpath d='M32 22 42 32 32 42 22 32Z' fill='%23fff'/%3E%3C/svg%3E"
    />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class="buddha-dashboard-body">
    <a class="dashboard-skip-link" href="#main-content">Skip to dashboard</a>
    <slot />
  </body>
</html>
